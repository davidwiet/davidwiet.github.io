---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Public drafts and working papers by David Wietchner.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; font-family: Charter, 'Iowan Old Style', Georgia, serif; color: #1f2933; background: #f8f7f4; }
  body { margin: 0; line-height: 1.6; }
  main { max-width: 48rem; margin: 0 auto; padding: 4rem 1.5rem 6rem; }
  h1, h2, h3 { font-family: ui-sans-serif, system-ui, sans-serif; line-height: 1.15; color: #102a43; }
  h1 { font-size: clamp(2rem, 6vw, 3.5rem); margin: 0 0 1rem; }
  h2 { margin-top: 2.75rem; }
  a { color: #1864ab; }
  .eyebrow, .metadata { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.9rem; color: #52616b; }
  .metadata { border-top: 1px solid #d9e2ec; border-bottom: 1px solid #d9e2ec; padding: 1rem 0; margin: 2rem 0; }
  .work-list { list-style: none; padding: 0; }
  .work-list li { padding: 1.4rem 0; border-bottom: 1px solid #d9e2ec; }
  .work-list a { font-family: ui-sans-serif, system-ui, sans-serif; font-weight: 700; font-size: 1.2rem; }
  blockquote { border-left: 0.25rem solid #9fb3c8; margin-left: 0; padding-left: 1rem; color: #486581; }
</style>
