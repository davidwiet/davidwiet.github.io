---
import BaseLayout from '../../layouts/BaseLayout.astro';
import archive from '../../../content/blog/posts.json';

export function getStaticPaths() {
  return archive.posts.map((post) => ({params: {slug: post.mirror_slug}, props: {post}}));
}

const { post } = Astro.props;
const article = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: post.title, description: post.description,
  datePublished: post.published_at,
  ...(post.source_updated_at ? {dateModified: post.source_updated_at} : {}),
  author: {'@type': 'Person', name: post.author, url: 'https://davidwiet.substack.com/'},
  url: new URL(`/blog/${post.mirror_slug}/`, Astro.site).href,
  isBasedOn: post.source_url,
  mainEntityOfPage: post.source_url,
};
---

<BaseLayout title={`${post.title} — The Human Image`} description={post.description} canonical={post.source_url}>
  <article>
    <header>
      <p class="eyebrow"><a href="/blog/">THE HUMAN IMAGE</a></p>
      <h1>{post.title}</h1>
      {post.subtitle && <p>{post.subtitle}</p>}
      <p class="metadata">{post.author} · <time datetime={post.published_at}>{post.published_at.slice(0, 10)}</time> · <a href={post.source_url}>Original on Substack</a></p>
    </header>
    <div class="blog-body" data-source-sha256={post.body_sha256} set:html={post.body_html} />
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(article).replace(/</g, '\\u003c')} />
</BaseLayout>

<style is:global>
  .blog-body { overflow-wrap: anywhere; }
  .blog-body img, .blog-body video { display: block; max-width: 100%; height: auto; }
  .blog-body figure { margin: 2rem 0; }
  .blog-body figcaption { margin-top: 0.5rem; font-size: 0.85rem; color: #52616b; }
  .blog-body .image-link-expand { display: none; }
  .blog-body a { text-decoration-thickness: 0.06em; text-underline-offset: 0.15em; }
</style>
